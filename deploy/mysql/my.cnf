# Tuned for a 4 GB VPS shared with the API (MySQL container is capped at 1 GB).
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = '+07:00'
skip-name-resolve

innodb_buffer_pool_size = 512M
max_connections = 50
# performance_schema alone takes a few hundred MB of RAM.
performance_schema = OFF
# Binary logs are on by default in MySQL 8 and fill a small disk; backups use mysqldump instead.
skip-log-bin
