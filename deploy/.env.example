# Copy to .env on the VPS (cp .env.example .env) and fill in. Never commit the real .env.
# Generate secrets with: openssl rand -base64 48

# Domain pointing (DNS A record) at the VPS, without https://
DOMAIN=upsc.vn

MYSQL_ROOT_PASSWORD=
DB_USERNAME=vierec
DB_PASSWORD=
# At least 32 characters
JWT_SECRET=

# SMTP for password reset codes. Leave MAIL_HOST empty to write the emails to the log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=VIEREC Academy <no-reply@vierec.vn>
