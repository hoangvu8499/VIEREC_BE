# Copy to .env and adjust. Never commit the real .env.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8383

DB_URL=jdbc:mysql://localhost:3306/vierec?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=root

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=1800000
JWT_REFRESH_TTL=2592000000

# Auth cookies. COOKIE_SECURE must be true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

CORS_ORIGINS=http://localhost:8484

# Uploaded lesson files are stored on the server in UPLOAD_DIR.
UPLOAD_DIR=./uploads
UPLOAD_MAX_DOCUMENT_SIZE=50MB
UPLOAD_MAX_VIDEO_SIZE=500MB
UPLOAD_MAX_FILE_SIZE=500MB
UPLOAD_MAX_REQUEST_SIZE=600MB
